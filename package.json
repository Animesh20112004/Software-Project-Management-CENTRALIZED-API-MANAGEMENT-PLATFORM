{
  "name": "centralized-api-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "next build apps/dashboard --webpack",
    "test": "node --test tests/*.test.mjs",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose stop postgres redis",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "demo:check": "node --env-file-if-exists=.env scripts/demo-check.mjs",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "test:docker": "docker compose --profile tools run --rm checks",
    "test:load": "docker compose --profile tools run --rm load-test",
    "format": "prettier --write apps scripts services tests package.json compose.yaml README.md IMPLEMENTATION.md VERIFICATION.md"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4.1.0",
    "express": "^5.1.0",
    "fastify": "^5.6.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.9.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  }
}
