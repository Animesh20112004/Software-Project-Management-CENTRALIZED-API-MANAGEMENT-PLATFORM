# =================================================================
# Centralized API Management Platform - Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# Application Environment & Network Binding
# -----------------------------------------------------------------
# Environment mode ('development' or 'production')
NODE_ENV=production

# Public listening port (Render sets this dynamically via $PORT)
PORT=3000

# Network interface to bind to ('0.0.0.0' for cloud/Docker, '127.0.0.1' for local)
HOST=0.0.0.0

# -----------------------------------------------------------------
# Authentication & Credentials
# -----------------------------------------------------------------
# Administrator username
ADMIN_USER=admin

# Administrator password (MUST be changed in production; 'local-demo-123' is rejected in production)
ADMIN_PASSWORD=change-to-a-secure-random-password-32chars

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL / Neon)
# -----------------------------------------------------------------
# Database mode: 'postgres' (recommended for production/Neon) or 'embedded' (PGlite for local dev)
DB_MODE=postgres

# PostgreSQL Connection String (e.g. from Neon.tech, Render Postgres, Supabase)
DATABASE_URL=postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/platform?sslmode=require

# SSL Configuration for cloud databases
DATABASE_SSL=true
DATABASE_REJECT_UNAUTHORIZED=false

# Connection Pool Settings
DATABASE_MAX_CONNECTIONS=8
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Local embedded data directory (only used when DB_MODE=embedded)
DATA_DIR=data/platform

# -----------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------
# Rate limiter mode: 'memory' (sliding-window, zero dependencies) or 'redis'
RATE_LIMIT_MODE=memory

# Redis Connection URL (required only if RATE_LIMIT_MODE=redis)
# REDIS_URL=redis://default:password@redis-cloud.com:6379

# -----------------------------------------------------------------
# Internal Ports & Microservice Endpoints
# -----------------------------------------------------------------
GATEWAY_PORT=4000
USERS_PORT=4001
PRODUCTS_PORT=4002

# Internal service URLs (used for communication between processes)
# GATEWAY_URL=http://127.0.0.1:4000
# USERS_URL=http://127.0.0.1:4001
# PRODUCTS_URL=http://127.0.0.1:4002

# Whether to run sample upstream microservices (users and products)
ENABLE_SAMPLE_SERVICES=true

# -----------------------------------------------------------------
# Security, CORS & Cookies
# -----------------------------------------------------------------
# Allowed origins for Dashboard requests (Render public URL is auto-detected)
# DASHBOARD_ORIGINS=https://my-platform.onrender.com,http://localhost:3000

# Secure cookies (automatically enabled in production)
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

# Initial demo data seeding (seeds /users and /products if DB is fresh)
SEED_DEMO_DATA=true

# Upstream proxy request timeout in milliseconds
UPSTREAM_TIMEOUT_MS=5000
