# Local academic demo only. These match compose.yaml.
ADMIN_USER=admin
ADMIN_PASSWORD=local-demo-123
# Local demo runs without Docker. Switch BOTH values for external services.
DB_MODE=embedded
RATE_LIMIT_MODE=memory
DATA_DIR=data/platform
DASHBOARD_PORT=3000
GATEWAY_PORT=4000
USERS_PORT=4001
PRODUCTS_PORT=4002
DATABASE_URL=postgresql://platform:platform_local@127.0.0.1:5432/platform
REDIS_URL=redis://127.0.0.1:6379
